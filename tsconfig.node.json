{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./out",
    "rootDir": "."
  },
  "include": [
    "electron/**/*.ts",
    "electron.vite.config.ts",
    "src/types/electron.ts",
    "src/types/ai.ts",
    "src/types/documentAgent.ts",
    "src/utils/documentAgent.ts",
    "src/utils/documentAgentBlocks.ts",
    "src/utils/aiChatContext.ts",
    "src/types/update.ts",
    // 主进程也会组装 AI 聊天引用，需将共用工具纳入 Node 项目检查。
    "src/utils/aiChatContext.ts",
    "src/constants/ipcChannels.ts"
  ]
}
