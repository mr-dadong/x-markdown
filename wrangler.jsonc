{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xmd-site",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-28",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
