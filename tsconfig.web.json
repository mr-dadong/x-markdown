{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "baseUrl": ".",
    "outDir": "./out"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "src/vite-env.d.ts",
    "electron/ai/documentAgentTools.ts",
    // 执行器回归测试使用真实 SDK 循环，一并检查共享实现。
    "electron/ai/documentAgentRun.ts",
    "package.json"
  ]
}
