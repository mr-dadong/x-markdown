{
  "name": "markdown-editor",
  "version": "1.3.7",
  "desktopName": "com.xmd.markdown-editor.desktop",
  "description": "A Typora-like Markdown editor built with Electron + Vue 3 + TipTap",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && bun scripts/write-renderer-build-id.mjs",
    "dist:win": "bun run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "bun run build && electron-builder --mac dmg --x64 --arm64 --publish never",
    "dist:mac:x64": "bun run build && electron-builder --mac dmg --x64 --publish never",
    "dist:mac:arm64": "bun run build && electron-builder --mac dmg --arm64 --publish never",
    "dist:linux": "bun run build && electron-builder --linux AppImage --x64 --arm64 --publish never",
    "dist:linux:x64": "bun run build && electron-builder --linux AppImage --x64 --publish never",
    "dist:linux:arm64": "bun run build && electron-builder --linux AppImage --arm64 --publish never",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json",
    "test": "bun test ./src",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "changelog:new": "bun scripts/changelog.mjs new",
    "changelog:sync": "bun scripts/changelog.mjs sync",
    "site:sync-nav": "bun scripts/site-navigation.mjs",
    "bun:dev": "bun run dev",
    "bun:build": "bun run build",
    "bun:preview": "bun run preview",
    "bun:install": "bun install",
    "postinstall": "node node_modules/electron/install.js"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@mastra/core": "^1.67.0",
    "@mastra/rag": "^2.6.3",
    "@tiptap/extension-subscript": "^3.31.3",
    "@tiptap/extension-superscript": "^3.31.3",
    "chokidar": "^5.0.0",
    "html-to-image": "^1.11.13",
    "markdown-it-mark": "^4.0.0",
    "openai": "^7.19.0"
  },
  "devDependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-markdown": "^6.5.2",
    "@iconify-icons/lucide": "^2.0.10",
    "@iconify-icons/mdi": "^2.0.0",
    "@iconify/vue": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tiptap/extension-code": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-hard-break": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-typography": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "autoprefixer": "^10.6.1",
    "codemirror": "6.0.2",
    "dompurify": "^3.4.15",
    "electron": "^44.4.3",
    "electron-builder": "^26.16.1",
    "electron-vite": "^6.0.0-beta.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "happy-dom": "^20.14.5",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "lowlight": "^3.3.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.0.0",
    "postcss": "^8.5.28",
    "sass": "^1.104.1",
    "tailwindcss": "^4.3.3",
    "tiptap-markdown": "^0.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "keywords": [
    "markdown",
    "editor",
    "electron",
    "vue",
    "tiptap",
    "typora"
  ],
  "author": "dadong",
  "license": "GPL-3.0-only",
  "build": {
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "appId": "com.xmd.markdown-editor",
    "productName": "XMD",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "executableName": "XMD",
      "icon": "build/icons/icon.ico",
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icons/icon.icns",
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown"
          ],
          "name": "Markdown",
          "description": "Markdown 文档",
          "role": "Editor",
          "rank": "Owner"
        },
        {
          "ext": "txt",
          "name": "Plain Text",
          "description": "纯文本文档",
          "role": "Editor",
          "rank": "Default"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons",
      "category": "Utility",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-Linux-${arch}.${ext}",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown"
          ],
          "name": "Markdown",
          "description": "Markdown 文档",
          "mimeType": "text/markdown"
        },
        {
          "ext": "txt",
          "name": "Plain Text",
          "description": "纯文本文档",
          "mimeType": "text/plain"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico"
    }
  }
}