{
  "name": "markdown-editor",
  "version": "1.2.5",
  "desktopName": "com.xmd.markdown-editor.desktop",
  "description": "A Typora-like Markdown editor built with Electron + Vue 3 + TipTap",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && bun scripts/write-renderer-build-id.mjs",
    "dist:win": "bun run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "bun run build && electron-builder --mac dmg --x64 --arm64 --publish never",
    "dist:mac:x64": "bun run build && electron-builder --mac dmg --x64 --publish never",
    "dist:mac:arm64": "bun run build && electron-builder --mac dmg --arm64 --publish never",
    "dist:linux": "bun run build && electron-builder --linux AppImage --x64 --arm64 --publish never",
    "dist:linux:x64": "bun run build && electron-builder --linux AppImage --x64 --publish never",
    "dist:linux:arm64": "bun run build && electron-builder --linux AppImage --arm64 --publish never",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json",
    "test": "bun test ./src",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "changelog:new": "bun scripts/changelog.mjs new",
    "changelog:sync": "bun scripts/changelog.mjs sync",
    "site:sync-nav": "bun scripts/site-navigation.mjs",
    "bun:dev": "bun run dev",
    "bun:build": "bun run build",
    "bun:preview": "bun run preview",
    "bun:install": "bun install",
    "postinstall": "node node_modules/electron/install.js"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@mastra/core": "1.61.0",
    "@mastra/rag": "2.6.0",
    "@tiptap/extension-subscript": "2.27.2",
    "@tiptap/extension-superscript": "2.27.2",
    "chokidar": "^4.0.3",
    "markdown-it-mark": "4.0.0",
    "openai": "7.5.0"
  },
  "devDependencies": {
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-markdown": "6.5.2",
    "@iconify-icons/lucide": "1.2.135",
    "@iconify-icons/mdi": "1.2.48",
    "@iconify/vue": "^4.1.1",
    "@tiptap/extension-code": "2.27.2",
    "@tiptap/extension-code-block-lowlight": "^2.1.12",
    "@tiptap/extension-color": "^2.1.12",
    "@tiptap/extension-hard-break": "2.27.2",
    "@tiptap/extension-highlight": "^2.1.12",
    "@tiptap/extension-image": "^2.1.12",
    "@tiptap/extension-link": "^2.1.12",
    "@tiptap/extension-placeholder": "^2.1.12",
    "@tiptap/extension-table": "^2.1.12",
    "@tiptap/extension-table-cell": "^2.1.12",
    "@tiptap/extension-table-header": "^2.1.12",
    "@tiptap/extension-table-row": "^2.1.12",
    "@tiptap/extension-task-item": "2.27.2",
    "@tiptap/extension-task-list": "2.27.2",
    "@tiptap/extension-text-align": "^2.1.12",
    "@tiptap/extension-text-style": "^2.1.12",
    "@tiptap/extension-typography": "^2.1.12",
    "@tiptap/extension-underline": "^2.1.12",
    "@tiptap/starter-kit": "^2.1.12",
    "@tiptap/vue-3": "^2.1.12",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "^13.0.7",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^4.5.2",
    "autoprefixer": "10.5.4",
    "codemirror": "6.0.2",
    "dompurify": "^3.4.12",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^1.0.29",
    "eslint": "^9.32.0",
    "eslint-plugin-vue": "^10.3.0",
    "happy-dom": "^18.0.1",
    "highlight.js": "^11.11.1",
    "jszip": "3.10.1",
    "katex": "0.18.1",
    "lowlight": "^3.0.0",
    "markdown-it": "^14.0.0",
    "mermaid": "11.16.0",
    "postcss": "8.5.23",
    "sass": "^1.69.5",
    "tailwindcss": "3",
    "tiptap-markdown": "^0.8.10",
    "typescript": "5.3.3",
    "typescript-eslint": "^8.38.0",
    "unplugin-auto-import": "^0.17.3",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.0.10",
    "vue": "^3.3.8",
    "vue-tsc": "^1.8.27"
  },
  "keywords": [
    "markdown",
    "editor",
    "electron",
    "vue",
    "tiptap",
    "typora"
  ],
  "author": "dadong",
  "license": "GPL-3.0-only",
  "build": {
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "appId": "com.xmd.markdown-editor",
    "productName": "XMD",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "executableName": "XMD",
      "icon": "build/icons/icon.ico",
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icons/icon.icns",
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown"
          ],
          "name": "Markdown",
          "description": "Markdown 文档",
          "role": "Editor",
          "rank": "Owner"
        },
        {
          "ext": "txt",
          "name": "Plain Text",
          "description": "纯文本文档",
          "role": "Editor",
          "rank": "Default"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons",
      "category": "Utility",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-Linux-${arch}.${ext}",
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown"
          ],
          "name": "Markdown",
          "description": "Markdown 文档",
          "mimeType": "text/markdown"
        },
        {
          "ext": "txt",
          "name": "Plain Text",
          "description": "纯文本文档",
          "mimeType": "text/plain"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico"
    }
  }
}